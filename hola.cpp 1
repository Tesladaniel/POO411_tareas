#include <iostream>
#include <vector>
#include <string>

struct Estudiante
{
    std::string nombre;
    std::string apellido;
    int matricula;
};

int main()
{
    std::vector<Estudiante> lista;
    int op;

    do
    {
        std::cout << "\n1. Registrar\n2. Ver\n3. Salir\nOpcion: ";
        std::cin >> op;
        std::cin.ignore();

        if(op == 1)
        {
            Estudiante e;

            std::cout << "Nombre: ";
            std::getline(std::cin, e.nombre);

            std::cout << "Apellido: ";
            std::getline(std::cin, e.apellido);

            std::cout << "Matricula: ";
            std::cin >> e.matricula;
            std::cin.ignore();

            lista.push_back(e);

            std::cout << "Estudiante registrado.\n";
        }

        else if(op == 2)
        {
            for(size_t i = 0; i < lista.size(); i++)
            {
                std::cout << "\nNombre: " << lista[i].nombre
                          << "\nApellido: " << lista[i].apellido
                          << "\nMatricula: " << lista[i].matricula
                          << "\n";
            }
        }

    } while(op != 3);

    return 0;
}

